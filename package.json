{
  "name": "sm-fairplay-svelte",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint-staged": "lint-staged",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "type:check": "pnpm check",
    "test": "vitest run src/lib/utils/*.spec.ts",
    "e2e": "playwright test",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "bits-ui": "2.22.0",
    "chart.js": "4.6.1",
    "clsx": "2.1.1",
    "lucide-svelte": "1.0.1",
    "svelte-sonner": "1.2.3",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript/native": "npm:typescript@7",
    "autoprefixer": "10.7.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "lint-staged": "17.6.2",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
